{
  "private": true,
  "name": "my-nextron-app",
  "description": "My application description",
  "version": "0.0.1",
  "author": "MogamiTsuchikawa",
  "main": "app/main.js",
  "scripts": {
    "dev": "nextron",
    "build": "nextron build",
    "build:check": "nextron build --no-pack",
    "typecheck": "next typegen renderer && tsc --noEmit -p tsconfig.json && tsc --noEmit -p renderer/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:electron": "node scripts/electron-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build:check",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-serve": "^3.0.1",
    "electron-store": "^11.0.2",
    "lucide-react": "^1.52.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "next": "^16.3.8",
    "nextron": "^10.3.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "ws": "^8.22.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
